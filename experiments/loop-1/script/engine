#!/usr/bin/env bash
# The container engine of the agent-loop study (PREREG 7.1): one colima machine of its own
# profile, with 2 CPUs, 4 GiB of memory and a 30 GiB disk, whose only mounts are $LOOP1_WORK,
# read-write, and $LOOP1_PRODUCT, read-only.
#
#   script/engine start    start the machine (a no-op when it runs)
#   script/engine stop     stop the machine whatever its state
#   script/engine host     print the DOCKER_HOST every docker command names
#
# The machine activates no docker context and writes no ssh configuration, so a bare
# `docker` keeps talking to whatever engine the user chose; every command of the study names
# this machine's socket instead (script/docker).
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=experiments/loop-1/script/_paths
source "${here}/_paths"

readonly MEM_GUARD="${here}/../../../script/mem-guard"
readonly PROFILE="musthold-loop-1"
readonly CPUS=2
readonly MEMORY_GIB=4
readonly DISK_GIB=30
readonly EXIT_USAGE=64

running() { colima status --profile "${PROFILE}" >/dev/null 2>&1; }

start() {
  mkdir -p "${LOOP1_WORK}" "${LOOP1_PRODUCT}"
  local work product
  work="$(cd "${LOOP1_WORK}" && pwd -P)"
  product="$(cd "${LOOP1_PRODUCT}" && pwd -P)"
  if running; then
    echo "engine: ${PROFILE} already runs" >&2
    return 0
  fi
  "${MEM_GUARD}" check
  colima start --profile "${PROFILE}" --cpu "${CPUS}" --memory "${MEMORY_GIB}" --disk "${DISK_GIB}" \
    --activate=false --ssh-config=false --mount "${work}:w" --mount "${product}" >&2
}

case "${1:-}" in
  start) start ;;
  stop) colima stop --profile "${PROFILE}" >/dev/null 2>&1 || true ;;
  host) echo "unix://${HOME}/.colima/${PROFILE}/docker.sock" ;;
  *)
    sed -n '2,12p' "${BASH_SOURCE[0]}" >&2
    exit "${EXIT_USAGE}"
    ;;
esac
