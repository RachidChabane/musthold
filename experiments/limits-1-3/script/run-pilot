#!/usr/bin/env bash
# Runs the PREREG 14 order for one run id. Each completed step leaves a marker, so a rerun after a
# pause (exit 3: quota, call budget or run window) resumes at the first unfinished step.
# Model-calling steps start only inside the run window (PILOT_RUN_WINDOW, default 21:00-07:30 local);
# PILOT_CALL_BUDGET overrides the daily call budget per CLI. Every heavy step runs under mem-guard and nice.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [[ $# -ne 1 ]]; then
  echo "usage: script/run-pilot <run-id>" >&2
  exit 2
fi
run_id="$1"
markers="runs/${run_id}/driver"
mkdir -p "${markers}"
guard=(../../script/mem-guard run -- nice -n 10)

# step name | verb | model-calling (1) or local (0)
sequence_before=(
  "canary|canary|1"
  "import-run-01|import-run-01|0"
  "relabel|relabel|1"
  "run-core|run-core|1"
  "run-blindspot|run-blindspot|1"
  "oracle-classify|oracle-classify|0"
  "audit-sample|audit-sample|0"
)
# The secondary stream and the luna stratum are independent: each is tried on every invocation, a pause of one
# never keeps the other from starting, and the steps after them wait for both to be complete or closed.
streams=(
  "run-secondary|run-secondary|1"
  "run-luna|run-luna|1"
)
sequence_after=(
  "amendment-check|amendment-check|0"
  "analyze|analyze|0"
  "report-lint|report-lint|0"
)

run_step() {
  local entry="$1" step verb calls_model extra=() status
  IFS='|' read -r step verb calls_model <<<"${entry}"
  if [[ -f "${markers}/${step}.done" ]]; then
    echo "[run-pilot] ${step}: already done"
    return 0
  fi
  if [[ "${calls_model}" == "1" ]]; then
    if ! ./script/run-window; then
      echo "[run-pilot] ${step}: outside the run window, not started" >&2
      return 3
    fi
    if [[ -n "${PILOT_CALL_BUDGET:-}" && "${verb}" != "canary" ]]; then
      extra=(--call-budget "${PILOT_CALL_BUDGET}")
    fi
  fi
  echo "[run-pilot] ${step}: start $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  status=0
  if [[ "${verb}" == "report-lint" ]]; then
    "${guard[@]}" "./script/${verb}" || status=$?
  else
    "${guard[@]}" "./script/${verb}" --run-id "${run_id}" ${extra[@]+"${extra[@]}"} || status=$?
  fi
  if [[ ${status} -ne 0 ]]; then
    echo "[run-pilot] ${step}: exit ${status} $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    return "${status}"
  fi
  date -u +%Y-%m-%dT%H:%M:%SZ > "${markers}/${step}.done"
  echo "[run-pilot] ${step}: done $(date -u +%Y-%m-%dT%H:%M:%SZ)"
}

for entry in "${sequence_before[@]}"; do
  run_step "${entry}" || exit $?
done

stream_status=0
for entry in "${streams[@]}"; do
  step="${entry%%|*}"
  status=0
  run_step "${entry}" || status=$?
  if [[ ${status} -ne 0 && ${stream_status} -eq 0 ]]; then
    stream_status=${status}
  fi
  if [[ ${status} -eq 0 && "${step}" == "run-luna" ]]; then
    run_step "oracle-classify-luna|oracle-classify|0" || exit $?
  fi
done
if [[ ${stream_status} -ne 0 ]]; then
  exit "${stream_status}"
fi

for entry in "${sequence_after[@]}"; do
  run_step "${entry}" || exit $?
done
echo "[run-pilot] all steps done"
