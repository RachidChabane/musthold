#!/usr/bin/env bash
# Probe the mined candidates offline, in seeded order, and keep the feasible tasks and reserves.
# Clones upstream mirrors and builds environments (network), runs suites with the network denied, all under mem-guard.
# Usage: bench/script/select --mining DIR --out DIR [--mirrors DIR] [--work DIR] [--tasks-per-language N] [--reserves-per-language N]
#   --mirrors defaults to bench/corpus/mirrors (ignored by version control); --work defaults to $SPECBENCH_WORK.
set -euo pipefail
# shellcheck source=bench/script/_lib
source "$(dirname "${BASH_SOURCE[0]}")/_lib"
args=("$@")
has_option() {
  local option
  for option in "${args[@]}"; do [[ "${option}" == "$1" ]] && return 0; done
  return 1
}
has_option --mirrors || args+=(--mirrors "${BENCH_DIR}/corpus/mirrors")
has_option --work || args+=(--work "${SPECBENCH_WORK}")
specbench_heavy select "${args[@]}"
