{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specbench.construction.h-selection/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "task_id", "seed", "rounds", "candidates", "criteria", "divergences"],
  "properties": {
    "schema": {"const": "specbench.construction.h-selection/1"},
    "task_id": {"type": "string", "minLength": 1},
    "seed": {"type": "integer"},
    "rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["round", "criteria", "calls"],
        "properties": {
          "round": {"type": "integer", "minimum": 0, "maximum": 2},
          "criteria": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "calls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^build-[0-9a-f]{20}$"}}
        }
      }
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "criterion", "kind", "round", "file", "merge", "base", "verdict"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "criterion": {"type": "string", "minLength": 1},
          "kind": {"enum": ["property", "example"]},
          "round": {"type": "integer", "minimum": 0, "maximum": 2},
          "file": {"type": "string", "minLength": 1},
          "merge": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/outcome"}},
          "base": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/outcome"}},
          "verdict": {
            "enum": ["kept", "rejected-merge", "rejected-base-pass", "rejected-flaky", "rejected-file", "surplus"]
          }
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "kept", "merge_rejects", "refilled", "exposed"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "kept": {"type": "integer", "minimum": 0, "maximum": 3},
          "merge_rejects": {"type": "integer", "minimum": 0},
          "refilled": {"type": "boolean"},
          "exposed": {"type": "boolean"}
        }
      }
    },
    "divergences": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "outcome": {"enum": ["passed", "failed", "error", "missing", "flaky"]}
  }
}
