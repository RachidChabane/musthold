{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specbench.construction.spec/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "overview", "interface", "criteria"],
  "properties": {
    "title": {"type": "string", "minLength": 1},
    "overview": {"type": "string", "minLength": 1},
    "interface": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["import_path", "signature", "note"],
        "properties": {
          "import_path": {"type": "string", "minLength": 1},
          "signature": {"type": "string", "minLength": 1},
          "note": {"type": "string"}
        }
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["number", "statement", "examples", "status"],
        "properties": {
          "number": {"type": "integer", "minimum": 1},
          "statement": {"type": "string", "minLength": 1},
          "examples": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "string", "minLength": 1}},
          "status": {"enum": ["new", "revised", "unchanged"]}
        }
      }
    }
  }
}
