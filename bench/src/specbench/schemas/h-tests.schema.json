{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specbench.construction.h-tests/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["files"],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "content"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "content": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
