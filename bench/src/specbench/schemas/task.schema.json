{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specbench.task/1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "base_sha",
    "criteria",
    "language",
    "licence",
    "lockfile_digests",
    "merge_sha",
    "merged_on",
    "pull_number",
    "repository",
    "schema",
    "task_id",
    "toolchain"
  ],
  "properties": {
    "schema": {"const": "specbench.task/1"},
    "task_id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*$"},
    "language": {"enum": ["python", "go"]},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pull_number": {"type": "integer", "minimum": 1},
    "merged_on": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "merge_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "licence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["notice_path", "path", "spdx_id"],
      "properties": {
        "spdx_id": {"enum": ["MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC"]},
        "path": {"type": "string", "minLength": 1},
        "notice_path": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "lockfile_digests": {
      "type": "object",
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {"name": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}}
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z0-9]+(?:-[A-Z0-9]+)*-[1-9][0-9]*$"},
          "status": {"enum": ["new", "revised", "unchanged"]}
        }
      }
    }
  }
}
