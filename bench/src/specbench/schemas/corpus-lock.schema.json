{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specbench.corpus-lock/1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "tasks"],
  "properties": {
    "schema": {"const": "specbench.corpus-lock/1"},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["bundle_sha256", "files", "language", "task_id", "task_json_sha256"],
        "properties": {
          "task_id": {"type": "string"},
          "language": {"enum": ["python", "go"]},
          "task_json_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "bundle_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "files": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
        }
      }
    }
  }
}
