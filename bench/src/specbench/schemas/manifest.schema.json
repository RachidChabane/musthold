{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "specbench.manifest/3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "budget_unit",
    "cli_versions",
    "corpus_lock_digest",
    "harness_models",
    "os",
    "prereg_tag",
    "prices_lock_digest",
    "product_digests",
    "run_id",
    "sample_tasks",
    "schema",
    "seed",
    "shallnot_commit",
    "toolchains"
  ],
  "properties": {
    "schema": {"const": "specbench.manifest/3"},
    "budget_unit": {"const": "model-execution"},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"},
    "seed": {"type": "integer"},
    "prereg_tag": {"type": "string", "minLength": 1},
    "product_digests": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "musthold-alignment",
        "musthold-completeness",
        "musthold-dp",
        "musthold-ledger",
        "musthold-s1",
        "musthold-verify",
        "shallnot",
        "umbrella-plugin"
      ],
      "properties": {
        "musthold-alignment": {"$ref": "#/$defs/sha256"},
        "musthold-completeness": {"$ref": "#/$defs/sha256"},
        "musthold-dp": {"$ref": "#/$defs/sha256"},
        "musthold-ledger": {"$ref": "#/$defs/sha256"},
        "musthold-s1": {"$ref": "#/$defs/sha256"},
        "musthold-verify": {"$ref": "#/$defs/sha256"},
        "shallnot": {"$ref": "#/$defs/sha256"},
        "umbrella-plugin": {"$ref": "#/$defs/sha256"}
      }
    },
    "shallnot_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cli_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claude", "codex"],
      "properties": {
        "claude": {"type": "string", "minLength": 1},
        "codex": {"type": "string", "minLength": 1}
      }
    },
    "corpus_lock_digest": {"$ref": "#/$defs/sha256"},
    "prices_lock_digest": {"$ref": "#/$defs/sha256"},
    "os": {"type": "string", "minLength": 1},
    "toolchains": {"type": "object", "additionalProperties": {"type": "string"}},
    "harness_models": {
      "type": "object",
      "propertyNames": {"enum": ["claude-code", "codex"]},
      "properties": {
        "claude-code": {"const": "claude-sonnet-5-5"},
        "codex": {"const": "gpt-6-luna"}
      },
      "additionalProperties": false
    },
    "sample_tasks": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
