{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rachid-chabane.com/host-protocol/ticket/v1",
  "title": "Host-protocol ticket: one issue of one vote of a request",
  "type": "object",
  "required": ["requestId", "vote", "emission", "nonce"],
  "properties": {
    "requestId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "vote": { "type": "integer", "minimum": 0 },
    "emission": { "type": "integer", "minimum": 1 },
    "nonce": { "type": "string", "pattern": "^[0-9a-f]{32}$" }
  }
}
