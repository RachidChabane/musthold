{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|collaborationspawn_agent|multi_agent_v1spawn_agent)$|mcp__musthold_dp_exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook pre-tool --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(musthold-dp-generator|musthold-dp-judge|musthold-dp-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook subagent-start --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(musthold-dp-generator|musthold-dp-judge|musthold-dp-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook subagent-stop --harness codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
