{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__spec-proof-dp-exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-dp hook pre-tool --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^spec-proof-dp:(generator|judge|decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-dp hook subagent-start --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^spec-proof-dp:(generator|judge|decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-dp hook subagent-stop --harness codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
