{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|collaborationspawn_agent|multi_agent_v1spawn_agent)$|mcp__spec_proof_dp_exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-dp hook pre-tool --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(spec-proof-dp-generator|spec-proof-dp-judge|spec-proof-dp-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-dp hook subagent-start --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(spec-proof-dp-generator|spec-proof-dp-judge|spec-proof-dp-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-dp hook subagent-stop --harness codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
