{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook post-tool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|mcp__plugin_musthold-dp_exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook pre-tool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(musthold-dp:generator|musthold-dp:judge|musthold-dp:decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook subagent-start --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(musthold-dp:generator|musthold-dp:judge|musthold-dp:decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-dp hook subagent-stop --harness claude",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
