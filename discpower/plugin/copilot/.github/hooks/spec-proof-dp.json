{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "spec-proof-dp hook pre-tool --harness copilot",
        "powershell": "spec-proof-dp hook pre-tool --harness copilot",
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "spec-proof-dp hook subagent-stop --harness copilot",
        "powershell": "spec-proof-dp hook subagent-stop --harness copilot",
        "timeoutSec": 30
      }
    ]
  }
}
