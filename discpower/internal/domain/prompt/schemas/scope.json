{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdicts"],
  "properties": {
    "verdicts": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^w[0-9]{1,3}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["answer"],
        "properties": {
          "answer": { "enum": ["FIXED", "NOT_FIXED", "UNDETERMINED"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "rationale": { "type": "string", "maxLength": 1000 }
        }
      }
    }
  }
}
