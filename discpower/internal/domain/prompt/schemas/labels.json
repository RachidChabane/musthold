{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["labels"],
  "properties": {
    "labels": {
      "type": "object",
      "propertyNames": { "pattern": "^p[0-9]{1,3}$" },
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^f[0-9]{1,4}$" }
      }
    }
  }
}
