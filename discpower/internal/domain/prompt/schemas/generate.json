{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["mutants"],
  "properties": {
    "mutants": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "mechanism", "edits"],
        "properties": {
          "slot": { "enum": ["S1", "S2", "S3"] },
          "mechanism": { "type": "string", "minLength": 1, "maxLength": 400 },
          "edits": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "qualname", "new_source"],
              "properties": {
                "file": { "type": "string", "minLength": 1 },
                "qualname": { "type": "string", "minLength": 1 },
                "target": { "enum": ["definition", "module_assignment"] },
                "new_source": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
