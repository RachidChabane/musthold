{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["validity"],
  "properties": {
    "validity": { "enum": ["VALID", "EQUIVALENT", "NOT_VIOLATING", "UNDETERMINED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string", "maxLength": 2000 },
    "witness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "args", "expected"],
      "properties": {
        "operation": { "type": "string", "minLength": 1 },
        "args": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "value"],
            "properties": {
              "type": { "enum": ["integer", "decimal", "string", "boolean", "null", "datetime"] },
              "value": { "type": "string" }
            }
          }
        },
        "expected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["returns", "raises"] },
            "type": { "enum": ["integer", "decimal", "string", "boolean", "null", "datetime"] },
            "value": { "type": "string" }
          }
        }
      }
    }
  }
}
