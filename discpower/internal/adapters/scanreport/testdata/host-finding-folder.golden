#!/bin/sh
# Runs tests/test_parse.py::test_parse_ok on 3f2a9c1 with mutant.patch applied; exit status 0 means the test still passes.
set -eu
finding="$(cd "$(dirname "$0")" && pwd)"
root="$(git -C "$finding" rev-parse --show-toplevel)"
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
git -C "$root" archive 3f2a9c1d0b8e7f6a5c4d3e2f1a0b9c8d7e6f5a4b | tar -x -C "$work"
for dependencies in .venv node_modules; do
  if [ -e "$root/$dependencies" ]; then ln -s "$root/$dependencies" "$work/$dependencies"; fi
done
if [ -d "$work/.venv/bin" ]; then PATH="$work/.venv/bin:$PATH"; export PATH; fi
cd "$work"
git apply "$finding/mutant.patch"
'python3' '-m' 'pytest' 'tests/test_parse.py::test_parse_ok'
