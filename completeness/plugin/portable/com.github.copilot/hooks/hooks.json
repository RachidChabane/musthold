{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "bash": "musthold-completeness hook pre-tool --harness copilot",
        "powershell": "musthold-completeness hook pre-tool --harness copilot",
        "timeoutSec": 30
      }
    ],
    "subagentStop": [
      {
        "type": "command",
        "bash": "musthold-completeness hook subagent-stop --harness copilot",
        "powershell": "musthold-completeness hook subagent-stop --harness copilot",
        "timeoutSec": 30
      }
    ]
  }
}
