{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook post-tool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|mcp__plugin_musthold-completeness_exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook pre-tool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(musthold-completeness:decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook subagent-start --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(musthold-completeness:decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook subagent-stop --harness claude",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
