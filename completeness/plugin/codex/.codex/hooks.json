{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__spec-proof-completeness-exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-completeness hook pre-tool --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(spec-proof-completeness-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-completeness hook subagent-start --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(spec-proof-completeness-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-completeness hook subagent-stop --harness codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
