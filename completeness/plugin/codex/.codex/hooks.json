{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(spawn_agent|collaborationspawn_agent|multi_agent_v1spawn_agent)$|mcp__musthold_completeness_exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook pre-tool --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(musthold-completeness-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook subagent-start --harness codex",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(musthold-completeness-decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "musthold-completeness hook subagent-stop --harness codex",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
