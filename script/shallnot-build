#!/usr/bin/env bash
# Build the pinned Shallnot into .tools/bin/shallnot, at the commit recorded in
# script/shallnot.pin, never from a working tree. The source is the local git
# repository script/shallnot-src names ($SHALLNOT_SRC, else next to the main
# working tree) when that directory exists, else the public repository
# https://github.com/RachidChabane/shallnot, fetched at the pin.
# A sidecar .tools/bin/shallnot.pin makes a re-run with an unchanged pin a no-op.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly EXIT_PRECONDITION=2
readonly PIN_FILE="script/shallnot.pin"
readonly BIN_DIR=".tools/bin"
readonly BIN="${BIN_DIR}/shallnot"
readonly BIN_PIN="${BIN_DIR}/shallnot.pin"
readonly PUBLIC_REPOSITORY_URL="https://github.com/RachidChabane/shallnot.git"
readonly MAIN_PACKAGE="./cmd/shallnot"
readonly VERSION_VAR="github.com/RachidChabane/shallnot/internal/version.injected"
readonly SCHEMA_VERSION_CURRENT="1.2"
readonly SCHEMA_VERSION_PREVIOUS="1.1"
readonly SHORT_SHA_LENGTH=12
readonly BUILD_PROCS=1
readonly BUILD_GOMAXPROCS=2
readonly BUILD_NICE=10

fail() {
  echo "shallnot-build: $*" >&2
  exit "${EXIT_PRECONDITION}"
}

# export_source writes the pinned source tree into the directory $1.
export_source() {
  local destination="$1"
  if [[ -d "${SRC}" ]]; then
    git -C "${SRC}" cat-file -e "${PIN}^{commit}" 2>/dev/null \
      || fail "commit ${PIN} is missing from ${SRC}"
    git -C "${SRC}" archive "${PIN}" | tar -x -C "${destination}"
    return
  fi
  local clone="${scratch}/clone"
  git init -q "${clone}"
  git -C "${clone}" fetch -q --depth 1 "${PUBLIC_REPOSITORY_URL}" "${PIN}" \
    || fail "commit ${PIN} cannot be fetched from ${PUBLIC_REPOSITORY_URL}"
  git -C "${clone}" archive FETCH_HEAD | tar -x -C "${destination}"
}

verify_binary() {
  local pattern
  pattern="$("${BIN}" schema report | jq -r '.properties.schema_version.pattern')"
  if [[ "${SCHEMA_VERSION_PREVIOUS}" =~ ${pattern} ]] || ! [[ "${SCHEMA_VERSION_CURRENT}" =~ ${pattern} ]]; then
    fail "the pinned build is older than report schema ${SCHEMA_VERSION_CURRENT}"
  fi
}

SRC="$(script/shallnot-src)"
PIN="$(tr -d '[:space:]' <"${PIN_FILE}")"
[[ "${PIN}" =~ ^[0-9a-f]{40}$ ]] || fail "${PIN_FILE} must hold one 40-hex commit SHA"

if [[ -x "${BIN}" && -f "${BIN_PIN}" && "$(cat "${BIN_PIN}")" == "${PIN}" ]]; then
  echo "shallnot-build: ${BIN} is up to date at ${PIN}"
  exit 0
fi

command -v go >/dev/null 2>&1 || fail "go is required to build shallnot"
command -v jq >/dev/null 2>&1 || fail "jq is required to verify the shallnot build"
command -v git >/dev/null 2>&1 || fail "git is required to read the shallnot source"

./script/mem-guard check

scratch="$(mktemp -d)"
trap 'rm -rf "${scratch}"' EXIT
source_tree="${scratch}/source"
mkdir "${source_tree}"
export_source "${source_tree}"

mkdir -p "${BIN_DIR}"
output="$(cd "${BIN_DIR}" && pwd)/shallnot"
(
  cd "${source_tree}"
  CGO_ENABLED=0 GOMAXPROCS="${BUILD_GOMAXPROCS}" nice -n "${BUILD_NICE}" \
    go build -p "${BUILD_PROCS}" \
    -ldflags "-X ${VERSION_VAR}=${PIN:0:${SHORT_SHA_LENGTH}}" \
    -o "${output}" "${MAIN_PACKAGE}"
)

verify_binary
echo "${PIN}" >"${BIN_PIN}"
echo "shallnot-build: built ${BIN} at ${PIN}"
