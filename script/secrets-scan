#!/usr/bin/env bash
# Scans the whole git history of the repository for secrets with gitleaks and the
# repository's .gitleaks.toml; values are redacted in the output.
#
#   script/secrets-scan
#
# Exit 0: no leak. 1: a leak was found. 2: gitleaks is not installed.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly EXIT_PRECONDITION=2

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "secrets-scan: gitleaks is not on PATH (https://github.com/gitleaks/gitleaks)" >&2
  exit "${EXIT_PRECONDITION}"
fi
exec gitleaks git --redact --no-banner --config .gitleaks.toml .
