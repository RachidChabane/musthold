#!/usr/bin/env bash
# Build what a live canary needs: script/product-build, which builds the whole product
# (the canary, Shallnot, every module binary and the umbrella plugin). With
# --canary-only only the canary is built, which is all a dry run needs.
set -euo pipefail
exec "$(dirname "${BASH_SOURCE[0]}")/product-build" "$@"
