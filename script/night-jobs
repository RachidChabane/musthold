#!/usr/bin/env bash
# Entry point of the scheduled night jobs, meant to be started by the operating
# system's scheduler (launchd on macOS), not by an interactive session.
#
#   script/night-jobs pilot     resume the amended pilot run (run-02) unless it is
#                               already running or finished
#   script/night-jobs canaries  run the live canaries of the host plugins once per
#                               night: Claude Code, then Codex, then Copilot
#   script/night-jobs construct build the benchmark corpus (bench/script/construct
#                               --night) with its own nightly call budget
#
# Every step keeps its own guards: the run window, the nightly call budget and
# script/mem-guard. Output goes to $NIGHT_JOBS_LOG_DIR (default
# ~/Library/Logs/spec-proof).
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly ROOT="${PWD}"
readonly LOG_DIR="${NIGHT_JOBS_LOG_DIR:-${HOME}/Library/Logs/spec-proof}"
readonly PILOT_DIR="experiments/limits-1-3"
readonly PILOT_RUN="run-02"
readonly CANARY_STAMP_DIR="${LOG_DIR}/canary-nights"
readonly SHALLNOT_SRC_DEFAULT="${ROOT}/../shallnot-proof-gate"
readonly EXIT_PAUSED=3
readonly CONSTRUCT_BUDGET="${NIGHT_JOBS_CONSTRUCT_BUDGET:-120}"
# Claude calls all night jobs may make in one night, shared with the owner's own
# quota; the canaries keep one call per harness session in reserve.
readonly NIGHT_CLAUDE_CAP="${NIGHT_JOBS_CLAUDE_CAP:-250}"
readonly CANARY_CLAUDE_RESERVE=1
readonly PILOT_LEDGER="${PILOT_DIR}/runs/${PILOT_RUN}/call_budget.json"

mkdir -p "${LOG_DIR}" "${CANARY_STAMP_DIR}"

log() {
  echo "[night-jobs $(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"
}

run_pilot() {
  local markers="${PILOT_DIR}/runs/${PILOT_RUN}/driver"
  if [[ -f "${markers}/report-lint.done" ]]; then
    log "pilot: ${PILOT_RUN} is finished"
    return 0
  fi
  if pgrep -f "script/run-pilot ${PILOT_RUN}" >/dev/null; then
    log "pilot: ${PILOT_RUN} is already running"
    return 0
  fi
  log "pilot: resuming ${PILOT_RUN}"
  (cd "${PILOT_DIR}" && caffeinate -is ./script/run-pilot "${PILOT_RUN}")
}

# run_canary runs one harness's canary and returns its exit status.
run_canary() {
  local harness="$1"
  shift
  log "canary: ${harness}"
  local status=0
  "script/canary-${harness}" "$@" || status=$?
  log "canary: ${harness} exit ${status}"
  return "${status}"
}

run_canaries() {
  local night stamp
  night="$(night_date)"
  stamp="${CANARY_STAMP_DIR}/${night}.done"
  if [[ -f "${stamp}" ]]; then
    log "canaries: already run for the night of ${night}"
    return 0
  fi
  export SHALLNOT_SRC="${SHALLNOT_SRC:-${SHALLNOT_SRC_DEFAULT}}"
  log "canaries: building"
  script/canary-build
  local failed=0
  run_canary claude --shared-home || failed=1
  run_canary codex || failed=1
  run_canary copilot || failed=1
  if [[ ${failed} -eq 0 ]]; then
    touch "${stamp}"
  else
    log "canaries: not every canary passed; the night stays open for a rerun"
  fi
}

# night_date names a night by the date it started on, also after midnight.
night_date() {
  date -v-12H +%Y-%m-%d
}

# pilot_claude_calls prints the Claude calls the pilot made in the given night.
pilot_claude_calls() {
  [[ -f "${PILOT_LEDGER}" ]] || {
    echo 0
    return 0
  }
  jq -r --arg night "$1" '.[$night].claude // 0' "${PILOT_LEDGER}"
}

# construct_budget prints the calls construction may make tonight: its own
# budget, bounded by what the nightly cap leaves after the pilot and the canaries.
construct_budget() {
  local left
  left=$((NIGHT_CLAUDE_CAP - $(pilot_claude_calls "$(night_date)") - CANARY_CLAUDE_RESERVE))
  ((left < CONSTRUCT_BUDGET)) && echo "$((left > 0 ? left : 0))" || echo "${CONSTRUCT_BUDGET}"
}

run_construct() {
  if pgrep -f "bench/script/construct|specbench.*construct" >/dev/null; then
    log "construct: already running"
    return 0
  fi
  local budget
  budget="$(construct_budget)"
  if [[ "${budget}" -eq 0 ]]; then
    log "construct: the nightly cap of ${NIGHT_CLAUDE_CAP} Claude calls is spent; the next night resumes"
    return 0
  fi
  log "construct: budget ${budget}"
  (cd bench && caffeinate -is script/construct --night --budget "${budget}")
}

main() {
  case "${1:-}" in
    pilot) run_pilot ;;
    canaries) run_canaries ;;
    construct) run_construct ;;
    *)
      echo "usage: script/night-jobs pilot | canaries | construct" >&2
      return 2
      ;;
  esac
}

main "$@" || {
  status=$?
  [[ ${status} -eq ${EXIT_PAUSED} ]] && log "paused (exit ${EXIT_PAUSED}); the next night resumes"
  exit "${status}"
}
