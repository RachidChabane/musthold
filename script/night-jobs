#!/usr/bin/env bash
# Entry point of the scheduled night jobs, meant to be started by the operating
# system's scheduler (launchd on macOS), not by an interactive session.
#
#   script/night-jobs pilot     resume the amended pilot run (run-02) unless it is
#                               already running or finished
#   script/night-jobs canaries  run the live canaries of the host plugins once per
#                               night: Claude Code, then Codex, then Copilot
#   script/night-jobs construct build the benchmark corpus (bench/script/construct
#                               --night) with its own nightly call budget
#
# Every step keeps its own guards: the run window, the nightly call budget and
# script/mem-guard. Output goes to $NIGHT_JOBS_LOG_DIR (default
# ~/Library/Logs/spec-proof).
#
# The canaries and construction run the pinned Claude Code (script/claude-code.pin): the job installs it with
# script/claude-code-install, puts its directory first on PATH and sets DISABLE_AUTOUPDATER=1, so the nightly canary
# validates the binary the benchmark runs. The pilot keeps the PATH it was pre-registered with.
#
# Environment:
#   NIGHT_JOBS_SLOTS=1           run each job under script/with-slot (pilot 2 slots, canaries 1,
#                                construct 1), so at most two jobs run at once on the machine.
#                                Off by default: a pilot holding both slots keeps the canaries and
#                                construct from starting until it ends.
#   NIGHT_JOBS_SLOT_WAIT_SECONDS how long a job waits for its slots before it pauses (default 0)
#   NIGHT_JOBS_DRY_RUN=1         print the commands the jobs would launch instead of launching them
#   NIGHT_JOBS_BUDGET_DELEGATE=0 compute construction's budget here instead of in bench/script/night-budget
#   NIGHT_JOBS_CLAUDE_TOKEN_SERVICE / NIGHT_JOBS_CLAUDE_TOKEN_ACCOUNT
#                                the keychain item that holds the Claude Code token (default service
#                                spec-proof-claude-oauth, account the macOS login); its presence, never its
#                                value, decides whether the Claude canary runs isolated
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly ROOT="${PWD}"
readonly LOG_DIR="${NIGHT_JOBS_LOG_DIR:-${HOME}/Library/Logs/spec-proof}"
readonly PILOT_DIR="experiments/limits-1-3"
readonly PILOT_RUN="run-02"
readonly CANARY_STAMP_DIR="${LOG_DIR}/canary-nights"
readonly SHALLNOT_SRC_DEFAULT="${ROOT}/../shallnot-proof-gate"
readonly EXIT_PAUSED=3
# The command that tells whether a job is already running on this machine.
# Tests point it at one that finds nothing, so a real job never leaks into them.
readonly RUNNING_PROBE="${NIGHT_JOBS_PGREP:-pgrep}"
readonly CONSTRUCT_BUDGET="${NIGHT_JOBS_CONSTRUCT_BUDGET:-120}"
# Claude calls all night jobs may make in one night, shared with the owner's own
# quota; the canaries keep one call per harness session in reserve.
readonly NIGHT_CLAUDE_CAP="${NIGHT_JOBS_CLAUDE_CAP:-250}"
readonly CANARY_CLAUDE_RESERVE=1
readonly PILOT_LEDGER="${NIGHT_BUDGET_PILOT_LEDGER:-${ROOT}/${PILOT_DIR}/runs/${PILOT_RUN}/call_budget.json}"
readonly WITH_SLOT="${ROOT}/script/with-slot"
readonly NIGHT_BUDGET="${ROOT}/bench/script/night-budget"
readonly EXIT_NO_SLOT=75
readonly PILOT_SLOTS=2
readonly CANARY_SLOTS=1
readonly CONSTRUCT_SLOTS=1
readonly CLAUDE_TOKEN_SERVICE="${NIGHT_JOBS_CLAUDE_TOKEN_SERVICE:-spec-proof-claude-oauth}"
CLAUDE_TOKEN_ACCOUNT="${NIGHT_JOBS_CLAUDE_TOKEN_ACCOUNT:-$(id -un)}"
readonly CLAUDE_TOKEN_ACCOUNT
readonly SLOT_WAIT_SECONDS="${NIGHT_JOBS_SLOT_WAIT_SECONDS:-0}"
readonly CLAUDE_CODE_PIN_FILE="${ROOT}/script/claude-code.pin"
readonly CLAUDE_CODE_INSTALL="script/claude-code-install"
readonly CLAUDE_CODE_TOOLS_DIR="${ROOT}/.tools/claude-code"
# The checks a canary may leave INCONCLUSIVE on a given CLI version without keeping the night open.
readonly KNOWN_INCONCLUSIVE_FILE="tools/canary/known-inconclusive.json"

mkdir -p "${LOG_DIR}" "${CANARY_STAMP_DIR}"

log() {
  echo "[night-jobs $(date -u +%Y-%m-%dT%H:%M:%SZ)] $*"
}

# launch runs a command of a job, or only prints it under NIGHT_JOBS_DRY_RUN=1.
launch() {
  if [[ "${NIGHT_JOBS_DRY_RUN:-0}" == 1 ]]; then
    log "dry-run: ${PWD}: $*"
    return 0
  fi
  "$@"
}

run_pilot() {
  local markers="${PILOT_DIR}/runs/${PILOT_RUN}/driver"
  if [[ -f "${markers}/report-lint.done" ]]; then
    log "pilot: ${PILOT_RUN} is finished"
    return 0
  fi
  if "${RUNNING_PROBE}" -f "script/run-pilot ${PILOT_RUN}" >/dev/null; then
    log "pilot: ${PILOT_RUN} is already running"
    return 0
  fi
  log "pilot: resuming ${PILOT_RUN}"
  (cd "${PILOT_DIR}" && launch caffeinate -is ./script/run-pilot "${PILOT_RUN}")
}

# use_pinned_claude installs the pinned Claude Code and makes it the `claude` of this job: its directory leads PATH and
# the updater is off. A job that cannot have it does not start.
use_pinned_claude() {
  local version bin_dir
  version="$(tr -d '[:space:]' <"${CLAUDE_CODE_PIN_FILE}")"
  bin_dir="${CLAUDE_CODE_TOOLS_DIR}/${version}/bin"
  launch "${CLAUDE_CODE_INSTALL}" || return 1
  export PATH="${bin_dir}:${PATH}"
  export DISABLE_AUTOUPDATER=1
  log "claude: pinned ${version}, ${bin_dir} leads PATH, DISABLE_AUTOUPDATER=1"
  if [[ "${NIGHT_JOBS_DRY_RUN:-0}" != 1 && "$(command -v claude)" != "${bin_dir}/claude" ]]; then
    log "claude: the pinned binary is not the claude on PATH"
    return 1
  fi
}

# known_inconclusive_checks prints the checks the registry declares known INCONCLUSIVE for a harness, each with the CLI
# version it is declared for, or nothing.
known_inconclusive_checks() {
  jq -r --arg harness "$1" '[.entries[] | select(.harness == $harness) | "\(.check) (\(.cli_version))"] | join(", ")' \
    "${KNOWN_INCONCLUSIVE_FILE}"
}

# run_canary runs one harness's canary and returns its exit status. Every canary receives the registry of known
# INCONCLUSIVE checks, so that only an undeclared open check keeps the night open.
run_canary() {
  local harness="$1"
  shift
  log "canary: ${harness}"
  local known
  known="$(known_inconclusive_checks "${harness}")"
  [[ -z "${known}" ]] || log "canary: ${harness} known inconclusive: ${known}"
  local status=0
  launch "script/canary-${harness}" "$@" --known-inconclusive "${KNOWN_INCONCLUSIVE_FILE}" || status=$?
  log "canary: ${harness} exit ${status}"
  return "${status}"
}

# claude_token_in_keychain succeeds when the keychain holds the Claude Code token. It asks for the item without its
# password (no -w), so the value is never read here.
claude_token_in_keychain() {
  security find-generic-password -s "${CLAUDE_TOKEN_SERVICE}" -a "${CLAUDE_TOKEN_ACCOUNT}" >/dev/null 2>&1
}

# run_claude_canary runs the Claude canary isolated when the keychain holds the token, and otherwise on the user's
# own configuration.
run_claude_canary() {
  if claude_token_in_keychain; then
    log "canary: claude runs isolated (keychain token)"
    run_canary claude
  else
    log "canary: claude shares the user's configuration (no keychain token)"
    run_canary claude --shared-home
  fi
}

run_canaries() {
  local night stamp
  night="$(night_date)"
  stamp="${CANARY_STAMP_DIR}/${night}.done"
  if [[ -f "${stamp}" ]]; then
    log "canaries: already run for the night of ${night}"
    return 0
  fi
  export SHALLNOT_SRC="${SHALLNOT_SRC:-${SHALLNOT_SRC_DEFAULT}}"
  log "canaries: building"
  launch script/canary-build
  use_pinned_claude || return 1
  local failed=0
  run_claude_canary || failed=1
  run_canary codex || failed=1
  run_canary copilot || failed=1
  if [[ ${failed} -eq 0 ]]; then
    touch "${stamp}"
  else
    log "canaries: not every canary passed; the night stays open for a rerun"
  fi
}

# night_date names a night by the date it started on, also after midnight.
night_date() {
  date -v-12H +%Y-%m-%d
}

# pilot_claude_calls prints the Claude calls the pilot made in the given night.
pilot_claude_calls() {
  [[ -f "${PILOT_LEDGER}" ]] || {
    echo 0
    return 0
  }
  jq -r --arg night "$1" '.[$night].claude // 0' "${PILOT_LEDGER}"
}

# fallback_construct_budget is construction's budget from the pilot's ledger and one canary call alone.
fallback_construct_budget() {
  local left
  left=$((NIGHT_CLAUDE_CAP - $(pilot_claude_calls "$(night_date)") - CANARY_CLAUDE_RESERVE))
  ((left < CONSTRUCT_BUDGET)) && echo "$((left > 0 ? left : 0))" || echo "${CONSTRUCT_BUDGET}"
}

# night_budget_share prints the executions bench/script/night-budget hands to a job tonight. It fails unless the
# computation succeeds and prints one integer.
night_budget_share() {
  local share
  share="$(
    NIGHT_BUDGET_PILOT_LEDGER="${PILOT_LEDGER}" \
      NIGHT_JOBS_CLAUDE_CAP="${NIGHT_CLAUDE_CAP}" \
      NIGHT_JOBS_CONSTRUCT_BUDGET="${CONSTRUCT_BUDGET}" \
      "${NIGHT_BUDGET}" "$1" --night "$(night_date)"
  )" || return 1
  [[ "${share}" =~ ^[0-9]+$ ]] || return 1
  echo "${share}"
}

# construct_budget prints the calls construction may make tonight: the share of the nightly cap that
# bench/script/night-budget gives it after the pilot and the canary reserve. When that computation fails the
# pilot-and-canary arithmetic stands in, so a fault in the computation never stops the night.
construct_budget() {
  if [[ "${NIGHT_JOBS_BUDGET_DELEGATE:-1}" == 1 ]]; then
    night_budget_share construct && return 0
    log "construct: night-budget failed; using the pilot ledger and the canary reserve" >&2
  fi
  fallback_construct_budget
}

run_construct() {
  if "${RUNNING_PROBE}" -f "bench/script/construct|specbench.*construct" >/dev/null; then
    log "construct: already running"
    return 0
  fi
  local budget
  budget="$(construct_budget)"
  if [[ "${budget}" -eq 0 ]]; then
    log "construct: the nightly cap of ${NIGHT_CLAUDE_CAP} Claude calls is spent; the next night resumes"
    return 0
  fi
  use_pinned_claude || return 1
  log "construct: budget ${budget}"
  (cd bench && launch caffeinate -is script/construct --night --budget "${budget}")
}

# run_job_in_slots runs a job under script/with-slot when NIGHT_JOBS_SLOTS=1, by starting this script again as a child
# of the slot holder; a job already inside its slots runs directly. No free slot pauses the job with exit 3.
run_job_in_slots() {
  local job="$1" slots="$2" status=0
  if [[ "${NIGHT_JOBS_SLOTS:-0}" != 1 || -n "${SPEC_PROOF_SLOTS_HELD:-}" ]]; then
    "run_${job}"
    return
  fi
  "${WITH_SLOT}" "${slots}" --wait "${SLOT_WAIT_SECONDS}" -- "${ROOT}/script/night-jobs" "${job}" || status=$?
  if [[ ${status} -eq ${EXIT_NO_SLOT} ]]; then
    log "${job}: ${slots} machine slot(s) are held by other jobs"
    return "${EXIT_PAUSED}"
  fi
  return "${status}"
}

main() {
  case "${1:-}" in
    pilot) run_job_in_slots pilot "${PILOT_SLOTS}" ;;
    canaries) run_job_in_slots canaries "${CANARY_SLOTS}" ;;
    construct) run_job_in_slots construct "${CONSTRUCT_SLOTS}" ;;
    *)
      echo "usage: script/night-jobs pilot | canaries | construct" >&2
      return 2
      ;;
  esac
}

main "$@" || {
  status=$?
  [[ ${status} -eq ${EXIT_PAUSED} ]] && log "paused (exit ${EXIT_PAUSED}); the next night resumes"
  exit "${status}"
}
