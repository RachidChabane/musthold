#!/usr/bin/env bash
# Everything CI runs for the Go product: for each module, lint, then the
# self-gate, which runs the module's tests and traces its specs to their results.
# Arguments name the modules to run; with none, every module of the workspace
# runs.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

if [ -d .tools/bin ]; then
  export PATH="$PWD/.tools/bin:$PATH"
fi

if ! command -v shallnot >/dev/null 2>&1; then
  echo "shallnot is required for the self-gate: install it or put it on PATH" >&2
  exit 2
fi

modules="${*:-$(script/modules)}"
for module in $modules; do
  script/lint "$module"
  echo "== gate $module"
  (
    cd "$module"
    mkdir -p build/test-results
    shallnot gate
  )
done
