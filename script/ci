#!/usr/bin/env bash
# Everything CI runs for the Go product: build the pinned Shallnot when its source
# is there, then for each module lint and run the self-gate, which runs the module's
# tests and traces its specs to their results. Arguments name the modules to run;
# with none, every module of the workspace runs.
#
# The pinned Shallnot is built from the git repository script/shallnot-src names
# ($SHALLNOT_SRC, else shallnot-proof-gate next to the main working tree). Without that source nothing is built, and the end-to-end
# tests that need the pinned Shallnot record a skip that names the reason; the gate
# reports a requirement whose bound tests were all skipped, so the requirement is
# never dropped silently.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

shallnot_src="$(script/shallnot-src)"

if [ -d "${shallnot_src}" ]; then
  SHALLNOT_SRC="${shallnot_src}" script/shallnot-build
else
  echo "ci: no Shallnot source at ${shallnot_src} (set SHALLNOT_SRC): the end-to-end tests that need the pinned Shallnot are skipped" >&2
fi

if [ -d .tools/bin ]; then
  export PATH="$PWD/.tools/bin:$PATH"
fi

if ! command -v shallnot >/dev/null 2>&1; then
  echo "shallnot is required for the self-gate: install it or put it on PATH" >&2
  exit 2
fi

modules="${*:-$(script/modules)}"
for module in $modules; do
  script/lint "$module"
  echo "== gate $module"
  (
    cd "$module"
    mkdir -p build/test-results
    shallnot gate
  )
done
