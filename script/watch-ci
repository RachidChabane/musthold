#!/usr/bin/env bash
# Waits for the CI workflow run of a commit on GitHub and reports its outcome, so a
# red run is seen as soon as it ends.
#
#   script/watch-ci [--notify] [COMMIT]   (default: HEAD)
#
# --notify also raises a desktop notification (terminal-notifier) when the run fails.
#
# Exit 0: the run succeeded, or no run exists for a commit CI ignores. 1: the run
# failed. 2: gh is missing. 3: the run was cancelled, as when a newer push to the
# same branch supersedes it; watch the newer commit instead.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly WORKFLOW="ci.yml"
readonly EXIT_PRECONDITION=2
readonly EXIT_CANCELLED=3
readonly CONCLUSION_CANCELLED="cancelled"
readonly CONCLUSION_SUCCESS="success"
readonly STATUS_COMPLETED="completed"
readonly POLL_SECONDS=20
readonly START_ATTEMPTS=15

command -v gh >/dev/null 2>&1 || {
  echo "watch-ci: gh is not on PATH" >&2
  exit "${EXIT_PRECONDITION}"
}
notify=0
if [[ "${1:-}" == "--notify" ]]; then
  notify=1
  shift
fi
sha="$(git rev-parse "${1:-HEAD}")"

# alert raises a desktop notification for a failed run when asked to.
alert() {
  if ((notify)) && command -v terminal-notifier >/dev/null 2>&1; then
    terminal-notifier -title "spec-proof CI" -message "CI failed on ${sha:0:7} (run $1)" >/dev/null 2>&1 || true
  fi
}

run_id=""
for _ in $(seq "${START_ATTEMPTS}"); do
  run_id="$(gh run list --workflow "${WORKFLOW}" --commit "${sha}" --limit 1 --json databaseId --jq '.[0].databaseId // empty' 2>/dev/null || true)"
  [[ -n "${run_id}" ]] && break
  sleep "${POLL_SECONDS}"
done
if [[ -z "${run_id}" ]]; then
  echo "watch-ci: no ${WORKFLOW} run for ${sha:0:7} (a commit that touches only ignored paths starts none)"
  exit 0
fi
echo "watch-ci: run ${run_id} for ${sha:0:7}"
# A failed query (a network error, a rate limit) says nothing about the run, so it
# is retried at the next poll; only a completed status ends the wait.
state=""
until [[ "${state%%/*}" == "${STATUS_COMPLETED}" ]]; do
  sleep "${POLL_SECONDS}"
  state="$(gh run view "${run_id}" --json status,conclusion --jq '.status + "/" + .conclusion' 2>/dev/null || true)"
done
conclusion="${state#*/}"
if [[ "${conclusion}" == "${CONCLUSION_SUCCESS}" ]]; then
  echo "watch-ci: run ${run_id} succeeded"
elif [[ "${conclusion}" == "${CONCLUSION_CANCELLED}" ]]; then
  echo "watch-ci: run ${run_id} was cancelled (superseded by a newer run, or stopped by hand)" >&2
  exit "${EXIT_CANCELLED}"
else
  echo "watch-ci: run ${run_id} FAILED" >&2
  alert "${run_id}"
  gh run view "${run_id}" --log-failed | grep -E 'error |##\[error\]' | head -20 >&2 || true
  exit 1
fi
