#!/usr/bin/env bash
# Regenerate the committed plugin trees from the generators they come from:
#   <module>/plugin/{claude,codex,copilot} of each proof module,
#   s1relay/plugin/claude, and the marketplace and thin plugin of umbrella/.
# `script/test <module>` fails when a committed tree differs from its generator.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# <module> <package> <test> of each generator.
readonly GENERATORS=(
  "discpower ./internal/domain/hostfiles TestCommittedFilesAreGenerated"
  "alignment ./internal/domain/hostfiles TestCommittedFilesAreGenerated"
  "completeness ./internal/domain/hostfiles TestCommittedFilesAreGenerated"
  "s1relay ./internal/plugin TestCommittedTreeIsGenerated"
  "umbrella ./internal/umbrella TestGeneratedFiles"
)

for generator in "${GENERATORS[@]}"; do
  read -r module package test <<<"${generator}"
  echo "== plugin-gen ${module}"
  (
    cd "${module}"
    GOMAXPROCS=2 nice -n 10 go test -p 1 -count=1 "${package}" -run "${test}" -update
  )
done
