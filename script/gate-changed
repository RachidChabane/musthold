#!/usr/bin/env bash
# Runs the self-gate (script/ci) of every Go module a range of commits touches, so
# a push never carries a module whose gate fails.
#
#   script/gate-changed [BASE [HEAD]]   gate the modules changed in BASE..HEAD
#                                       (default: the upstream of the branch..HEAD)
#   script/gate-changed --list ...      print the modules without gating them
#
# A change to the shared format module, to go.work or to the scripts that build and
# gate every module selects every module. A change outside any module, other than
# the notes and the ADRs, selects tools/e2e, which checks the documentation and the
# chain of binaries. A change to the benchmark core, to the product it drives or
# records (every Go module), to the bench scripts or to the CI workflow also runs
# the benchmark core's checks (bench/script/check), which include the check of the
# recorded parcel answers; it first builds the product from the work tree
# (script/product-build), so those checks never drive a stale build. The gate
# runs under nice with GOMAXPROCS=2, and waits for script/mem-guard to allow the
# benchmark core's tests rather than failing on a busy machine. When both the Go
# gates and the benchmark core's checks run and memory allows it at the start, the
# two run at the same time, unless another gate-changed runs on the machine, and
# the benchmark core's output follows the Go gates' output; GATE_SERIAL=1 runs
# them one after the other.
#
# Exit 0: every selected gate passed, or nothing to gate. 1: a gate failed.
# 2: usage error.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

readonly EXIT_USAGE=2
readonly NICE_LEVEL=10
readonly GATE_PROCS=2
readonly E2E_MODULE="tools/e2e"
# Paths whose change concerns every module.
readonly SHARED_PATHS='^(format/|go\.work|script/(ci|lint|modules|shallnot-build|shallnot\.pin|test)$)'
# Paths no gate reads.
readonly UNGATED_PATHS='^(notes/|docs/adr/)'
# Paths the benchmark core's checks read besides the Go modules.
readonly BENCH_PATHS='^(bench/|\.github/workflows/|script/(product-build|regen-bench-recordings|mem-guard)$)'
readonly BENCH_PSEUDO_MODULE="bench"
# How long the gate waits for script/mem-guard to allow the benchmark core's
# tests, and how often it asks.
readonly MEMORY_WAIT_SECONDS=1800
readonly MEMORY_POLL_SECONDS=30
readonly EXIT_GATE_FAILED=1
readonly SERIAL_FLAG="${GATE_SERIAL:-0}"

# wait_for_memory waits until script/mem-guard allows heavy work, so a busy
# machine delays the gate instead of failing it; it fails once the wait is over.
wait_for_memory() {
  local waited=0
  until script/mem-guard check >/dev/null 2>&1; do
    if ((waited >= MEMORY_WAIT_SECONDS)); then
      echo "gate-changed: memory stayed short for ${MEMORY_WAIT_SECONDS}s; the benchmark core was not checked" >&2
      return "${EXIT_GATE_FAILED}"
    fi
    echo "gate-changed: waiting for memory before the benchmark core's checks"
    sleep "${MEMORY_POLL_SECONDS}"
    waited=$((waited + MEMORY_POLL_SECONDS))
  done
}

list_only=0
if [[ "${1:-}" == "--list" ]]; then
  list_only=1
  shift
fi
if (($# > 2)); then
  echo "usage: script/gate-changed [--list] [BASE [HEAD]]" >&2
  exit "${EXIT_USAGE}"
fi
base="${1:-$(git rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || echo origin/main)}"
head="${2:-HEAD}"

all_modules=()
while IFS= read -r module; do
  all_modules+=("${module#./}")
done < <(script/modules)
changed=()
while IFS= read -r path; do
  changed+=("${path}")
done < <(git diff --name-only "${base}" "${head}")

# module_of prints the module that holds a path, or nothing.
module_of() {
  local path="$1" module best=""
  for module in "${all_modules[@]}"; do
    if [[ "${path}" == "${module}/"* && ${#module} -gt ${#best} ]]; then
      best="${module}"
    fi
  done
  echo "${best}"
}

selected=()
add() {
  local module="$1" present
  for present in "${selected[@]:-}"; do
    [[ "${present}" == "${module}" ]] && return 0
  done
  selected+=("${module}")
}

bench_needed=0
for path in "${changed[@]:-}"; do
  [[ -z "${path}" ]] && continue
  [[ "${path}" =~ ${BENCH_PATHS} ]] && bench_needed=1
  if [[ "${path}" =~ ${SHARED_PATHS} ]]; then
    selected=("${all_modules[@]}")
    break
  fi
  [[ "${path}" =~ ${UNGATED_PATHS} ]] && continue
  module="$(module_of "${path}")"
  add "${module:-${E2E_MODULE}}"
done

# Every Go module is driven or recorded by the benchmark core.
if ((${#selected[@]} > 0)); then
  bench_needed=1
fi

if ((${#selected[@]} == 0 && bench_needed == 0)); then
  echo "gate-changed: no module changed in ${base}..${head}"
  exit 0
fi
if ((list_only)); then
  if ((${#selected[@]} > 0)); then
    printf '%s\n' "${selected[@]}"
  fi
  if ((bench_needed)); then
    echo "${BENCH_PSEUDO_MODULE}"
  fi
  exit 0
fi
# gate_modules runs the self-gate of the selected Go modules.
gate_modules() {
  echo "gate-changed: gating ${selected[*]}"
  GOMAXPROCS="${GATE_PROCS}" nice -n "${NICE_LEVEL}" script/ci "${selected[@]/#/./}"
}

# check_bench runs the benchmark core's checks against the product already built.
check_bench() {
  echo "gate-changed: checking the benchmark core"
  wait_for_memory
  GOMAXPROCS="${GATE_PROCS}" nice -n "${NICE_LEVEL}" bench/script/check
}

# other_gate_running tells whether another gate-changed runs on this machine, so
# the two heavy jobs of a parallel gate are never added to another gate's.
other_gate_running() {
  local pid
  for pid in $(pgrep -f "script/gate-changed" 2>/dev/null); do
    [[ "${pid}" != "$$" ]] && return 0
  done
  return 1
}

# stop_bench stops the benchmark core's checks started in the background and the
# processes they started, by their parent's PID.
stop_bench() {
  if [[ -n "${bench_pid:-}" ]] && kill -0 "${bench_pid}" 2>/dev/null; then
    pkill -TERM -P "${bench_pid}" 2>/dev/null || true
    kill -TERM "${bench_pid}" 2>/dev/null || true
  fi
}

if ((bench_needed)); then
  GOMAXPROCS="${GATE_PROCS}" nice -n "${NICE_LEVEL}" script/product-build
fi
if ((${#selected[@]} > 0 && bench_needed)) && [[ "${SERIAL_FLAG}" != "1" ]] &&
  ! other_gate_running && script/mem-guard check >/dev/null 2>&1; then
  bench_log="$(mktemp)"
  trap 'stop_bench; rm -f "${bench_log}"' EXIT
  check_bench >"${bench_log}" 2>&1 &
  bench_pid=$!
  modules_status=0
  gate_modules || modules_status=$?
  bench_status=0
  wait "${bench_pid}" || bench_status=$?
  cat "${bench_log}"
  if ((modules_status != 0 || bench_status != 0)); then
    exit "${EXIT_GATE_FAILED}"
  fi
  exit 0
fi
if ((${#selected[@]} > 0)); then
  gate_modules
fi
if ((bench_needed)); then
  check_bench
fi
