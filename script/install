#!/usr/bin/env bash
# Verified installer for a musthold binary release. It is published as the asset
# `install` of every binary release.
#
#   install <module> <semver> [--prefix DIR] [--os OS] [--arch ARCH] [--from DIR]
#
# <module> is the module directory (discpower, alignment, completeness, s1relay,
# ledger or verify) and <semver> the version without its v. The binary lands in
# <prefix>/bin (default ~/.local/bin). The installer
#   1. checks the signature of SHA256SUMS with cosign, against the release workflow
#      of this repository at the tag, or the attestation of the archive with gh;
#   2. checks the archive against its line of SHA256SUMS;
#   3. runs the extracted binary with --version and requires exactly <semver>, when
#      the target platform is the platform of this machine. A binary built for
#      another platform (--os, --arch) cannot run here: it is not run, a line on
#      stderr says so, and its version is bound by the verified signature and
#      checksum of the release.
# Any failure, or no verifier at all, aborts the install and leaves nothing behind.
#
# --from DIR installs from a directory that holds the release files (a dist
# directory) instead of downloading them, and checks the checksum and the version
# only: it is how a release is rehearsed before anything is published.
set -euo pipefail

readonly REPOSITORY="RachidChabane/musthold"
readonly DOWNLOAD_BASE="https://github.com/${REPOSITORY}/releases/download"
readonly SIGNER_WORKFLOW="${REPOSITORY}/.github/workflows/release.yml"
readonly IDENTITY_PREFIX="https://github.com/${SIGNER_WORKFLOW}@refs/tags/"
readonly OIDC_ISSUER="https://token.actions.githubusercontent.com"
readonly CHECKSUMS_FILE="SHA256SUMS"
readonly BUNDLE_FILE="SHA256SUMS.sigstore.json"
readonly DEFAULT_PREFIX="${HOME:-.}/.local"
readonly SEMVER_PATTERN='^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$'
readonly MODULE_PATTERN='^[a-z0-9]+$'

readonly EXIT_USAGE=2
readonly EXIT_NO_VERIFIER=3
readonly EXIT_DOWNLOAD=4
readonly EXIT_SIGNATURE=5
readonly EXIT_CHECKSUM=6
readonly EXIT_VERSION=7
readonly EXIT_UNSUPPORTED=8
readonly EXIT_ARCHIVE=9

die() { # <exit code> <message>
  local code="$1"
  shift
  echo "install: $*" >&2
  exit "${code}"
}

have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  die "${EXIT_USAGE}" "usage: install <module> <semver> [--prefix DIR] [--os OS] [--arch ARCH] [--from DIR]"
}

module=""
semver=""
prefix="${DEFAULT_PREFIX}"
from_dir=""
work_dir=""
target_os=""
target_arch=""
host_os=""
host_arch=""

parse_arguments() {
  local positional=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --prefix) prefix="${2:?--prefix needs a directory}"; shift 2 ;;
      --from) from_dir="${2:?--from needs a directory}"; shift 2 ;;
      --os) target_os="${2:?--os needs a value}"; shift 2 ;;
      --arch) target_arch="${2:?--arch needs a value}"; shift 2 ;;
      -h | --help) usage ;;
      -*) usage ;;
      *) positional+=("$1"); shift ;;
    esac
  done
  [[ ${#positional[@]} -eq 2 ]] || usage
  module="${positional[0]}"
  semver="${positional[1]}"
  [[ "${module}" =~ ${MODULE_PATTERN} ]] || die "${EXIT_USAGE}" "module ${module} is not a module directory name"
  [[ "${semver}" =~ ${SEMVER_PATTERN} ]] || die "${EXIT_USAGE}" "version ${semver} is not MAJOR.MINOR.PATCH[-pre], without a leading v"
}

require_verifier() {
  [[ -n "${from_dir}" ]] && return 0
  have cosign || have gh || die "${EXIT_NO_VERIFIER}" "neither cosign nor gh is installed: nothing can verify the release, so nothing is installed"
}

detect_platform() {
  case "$(uname -s)" in
    Darwin) host_os="darwin" ;;
    Linux) host_os="linux" ;;
    MINGW* | MSYS* | CYGWIN*) host_os="windows" ;;
    *) host_os="$(uname -s)" ;;
  esac
  case "$(uname -m)" in
    x86_64 | amd64) host_arch="amd64" ;;
    arm64 | aarch64) host_arch="arm64" ;;
    *) host_arch="$(uname -m)" ;;
  esac
  [[ -n "${target_os}" ]] || target_os="${host_os}"
  [[ -n "${target_arch}" ]] || target_arch="${host_arch}"
  case "${target_os}" in linux | darwin | windows) ;; *) die "${EXIT_UNSUPPORTED}" "unsupported operating system ${target_os}" ;; esac
  case "${target_arch}" in amd64 | arm64) ;; *) die "${EXIT_UNSUPPORTED}" "unsupported architecture ${target_arch}" ;; esac
}

target_is_host() { [[ "${target_os}" == "${host_os}" && "${target_arch}" == "${host_arch}" ]]; }

check_version() { # <executable path> <executable name>
  if ! target_is_host; then
    echo "install: $2 is for ${target_os}/${target_arch}; its version is bound by the verified signature and checksum of the release, not checked by running it" >&2
    return 0
  fi
  local reported
  reported="$("$1" --version 2>/dev/null)" || die "${EXIT_VERSION}" "$2 does not run on this machine"
  [[ "${reported}" == "${semver}" ]] || die "${EXIT_VERSION}" "$2 reports version ${reported}, expected ${semver}"
}

sha256_of() { # <file>
  if have sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  elif have shasum; then
    shasum -a 256 "$1" | awk '{print $1}'
  else
    openssl dgst -sha256 "$1" | awk '{print $NF}'
  fi
}

fetch() { # <name> <destination>
  local name="$1" destination="$2"
  if [[ -n "${from_dir}" ]]; then
    cp "${from_dir}/${name}" "${destination}" || die "${EXIT_DOWNLOAD}" "${from_dir}/${name} cannot be read"
  else
    curl --fail --silent --show-error --location --output "${destination}" "${DOWNLOAD_BASE}/${module}/v${semver}/${name}" ||
      die "${EXIT_DOWNLOAD}" "cannot download ${name} of ${module}/v${semver}"
  fi
}

archive_name() { # <SHA256SUMS file>
  local pattern="_${semver}_${target_os}_${target_arch}\\.(tar\\.gz|zip)$"
  local matches
  matches="$(awk '{print $2}' "$1" | grep -E "${pattern}" || true)"
  [[ -n "${matches}" ]] || die "${EXIT_UNSUPPORTED}" "release ${module}/v${semver} has no archive for ${target_os}/${target_arch}"
  [[ "$(printf '%s\n' "${matches}" | wc -l | tr -d ' ')" -eq 1 ]] || die "${EXIT_ARCHIVE}" "release ${module}/v${semver} lists several archives for ${target_os}/${target_arch}"
  printf '%s\n' "${matches}"
}

verify_signature() { # <work dir> <archive name>
  local work="$1" archive="$2"
  if [[ -n "${from_dir}" ]]; then
    echo "install: --from: the signature is not checked"
    return 0
  fi
  if have cosign; then
    cosign verify-blob --bundle "${work}/${BUNDLE_FILE}" \
      --certificate-identity "${IDENTITY_PREFIX}${module}/v${semver}" \
      --certificate-oidc-issuer "${OIDC_ISSUER}" \
      "${work}/${CHECKSUMS_FILE}" >/dev/null 2>&1 || die "${EXIT_SIGNATURE}" "the signature of ${CHECKSUMS_FILE} does not verify against ${IDENTITY_PREFIX}${module}/v${semver}"
  else
    gh attestation verify "${work}/${archive}" --repo "${REPOSITORY}" \
      --signer-workflow "${SIGNER_WORKFLOW}" --source-ref "refs/tags/${module}/v${semver}" >/dev/null 2>&1 ||
      die "${EXIT_SIGNATURE}" "the attestation of ${archive} does not verify"
  fi
}

verify_checksum() { # <work dir> <archive name>
  local work="$1" archive="$2" expected actual
  expected="$(awk -v name="${archive}" '$2 == name {print $1}' "${work}/${CHECKSUMS_FILE}")"
  actual="$(sha256_of "${work}/${archive}")"
  [[ -n "${expected}" && "${expected}" == "${actual}" ]] || die "${EXIT_CHECKSUM}" "${archive} has digest ${actual}, ${CHECKSUMS_FILE} lists ${expected:-nothing}"
}

extract() { # <work dir> <archive name> <destination>
  local work="$1" archive="$2" destination="$3"
  mkdir -p "${destination}"
  case "${archive}" in
    *.tar.gz) tar -xzf "${work}/${archive}" -C "${destination}" || die "${EXIT_ARCHIVE}" "${archive} cannot be extracted" ;;
    *.zip) unzip -q "${work}/${archive}" -d "${destination}" || die "${EXIT_ARCHIVE}" "${archive} cannot be extracted" ;;
  esac
}

main() {
  parse_arguments "$@"
  require_verifier
  detect_platform

  work_dir="$(mktemp -d)"
  trap 'rm -rf "${work_dir}"' EXIT
  local work="${work_dir}"

  fetch "${CHECKSUMS_FILE}" "${work}/${CHECKSUMS_FILE}"
  [[ -n "${from_dir}" ]] || fetch "${BUNDLE_FILE}" "${work}/${BUNDLE_FILE}"
  local archive binary executable
  archive="$(archive_name "${work}/${CHECKSUMS_FILE}")"
  binary="${archive%%_"${semver}"_*}"
  executable="${binary}"
  [[ "${target_os}" == "windows" ]] && executable="${binary}.exe"
  fetch "${archive}" "${work}/${archive}"

  verify_signature "${work}" "${archive}"
  verify_checksum "${work}" "${archive}"
  extract "${work}" "${archive}" "${work}/tree"

  check_version "${work}/tree/${executable}" "${executable}"

  mkdir -p "${prefix}/bin"
  cp "${work}/tree/${executable}" "${prefix}/bin/${executable}"
  chmod 0755 "${prefix}/bin/${executable}"
  echo "install: ${executable} ${semver} installed to ${prefix}/bin"
}

main "$@"
