#!/usr/bin/env bash
# Run the docker client against the demonstration's engine, never against the user's
# current context, and with a client configuration of its own, which names no
# credential helper, so that no registry credential of the user is read or used:
#
#   demo/loop/container/docker ARGS...
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# ENGINE_CLIENT_CONFIG replaces the client configuration directory, for another study; the
# engine's own ENGINE_PROFILE selects the socket.
readonly CLIENT_CONFIG="${ENGINE_CLIENT_CONFIG:-${here}/../../../.tools/demo-loop/docker-config}"
mkdir -p "${CLIENT_CONFIG}"
[[ -f "${CLIENT_CONFIG}/config.json" ]] || echo '{}' >"${CLIENT_CONFIG}/config.json"
DOCKER_HOST="$("${here}/engine" host)"
DOCKER_CONFIG="$(cd "${CLIENT_CONFIG}" && pwd)"
export DOCKER_HOST DOCKER_CONFIG
unset DOCKER_CONTEXT
exec docker "$@"
