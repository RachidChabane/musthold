#!/usr/bin/env bash
# Front door of the agent-loop demonstration (demo/loop/README.md). The runner is
# tools/canary/cmd/spec-proof-demo-loop, built into .tools/bin.
#
#   demo/loop/run live [--dry-run] [--force-window] [--config FILE] [--out DIR]
#       run the configured sessions: build the product, install the pinned Claude
#       Code, then one headless session per run under script/mem-guard, in the
#       nightly window (21:00-07:30) unless forced. --dry-run prints every command
#       and starts nothing. A live run spends the model quota of the account whose
#       token the keychain item spec-proof-claude-oauth holds.
#   demo/loop/run keep RUN_DIR
#       keep the records of a run as the committed recording demo/loop/recording,
#       with the machine's paths written as placeholders
#   demo/loop/run replay [--check]
#       render the committed recording into demo/loop/recording/transcript.md and
#       transcript.html, starting no session; --check fails when they are stale
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../.."

readonly RUNNER=".tools/bin/spec-proof-demo-loop"
readonly CONFIG="demo/loop/demo.json"
readonly RECORDING="demo/loop/recording"
readonly BUILD_PROCS=1
readonly BUILD_GOMAXPROCS=2
readonly BUILD_NICE=10
readonly EXIT_USAGE=64

usage() {
  sed -n '2,17p' "${BASH_SOURCE[0]}" >&2
  exit "${EXIT_USAGE}"
}

build_runner() {
  mkdir -p "$(dirname "${RUNNER}")"
  GOMAXPROCS="${BUILD_GOMAXPROCS}" nice -n "${BUILD_NICE}" \
    go build -C tools/canary -p "${BUILD_PROCS}" -o "${PWD}/${RUNNER}" ./cmd/spec-proof-demo-loop
}

live() {
  local config="${CONFIG}" dry_run=0 forwarded=()
  while (($#)); do
    case "$1" in
      --config) config="$2"; shift 2 ;;
      --dry-run) dry_run=1; forwarded+=("$1"); shift ;;
      --force-window) forwarded+=("$1"); shift ;;
      --out) forwarded+=("$1" "$2"); shift 2 ;;
      *) usage ;;
    esac
  done
  build_runner
  if ((dry_run)); then
    exec "${RUNNER}" run --config "${config}" --repo . ${forwarded[@]+"${forwarded[@]}"}
  fi
  script/product-build
  script/claude-code-install >/dev/null
  exec script/mem-guard run -- "${RUNNER}" run --config "${config}" --repo . ${forwarded[@]+"${forwarded[@]}"}
}

keep() {
  (($# == 1)) || usage
  build_runner
  exec "${RUNNER}" keep --run "$1" --to "${RECORDING}" --repo .
}

replay() {
  local check=()
  case "${1:-}" in
    "") ;;
    --check) check=(--check) ;;
    *) usage ;;
  esac
  if [[ ! -f "${RECORDING}/run.json" ]]; then
    echo "demo/loop/run: no recording in ${RECORDING}: run \`demo/loop/run live\`, then \`demo/loop/run keep RUN_DIR\`" >&2
    exit 2
  fi
  build_runner
  exec "${RUNNER}" render --records "${RECORDING}" --out "${RECORDING}" ${check[@]+"${check[@]}"}
}

verb="${1:-}"
(($#)) && shift
case "${verb}" in
  live) live "$@" ;;
  keep) keep "$@" ;;
  replay) replay "$@" ;;
  *) usage ;;
esac
