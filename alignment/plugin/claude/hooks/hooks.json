{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-alignment hook post-tool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|mcp__plugin_spec-proof-alignment_exec__.*",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-alignment hook pre-tool --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "^(spec-proof-alignment:judge|spec-proof-alignment:decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-alignment hook subagent-start --harness claude",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "^(spec-proof-alignment:judge|spec-proof-alignment:decider)$",
        "hooks": [
          {
            "type": "command",
            "command": "spec-proof-alignment hook subagent-stop --harness claude",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "modules": [
    "./register.ts"
  ]
}
