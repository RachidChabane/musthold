      "ref": "PAR-3~1",
      "statement": "WHEN the quantity of a line is zero THE SYSTEM SHALL reject the line.\n\nExamples:\n  line_total(unit_price=4, quantity=0) => raises ValueError",
      "status": "active",
      "statement_digest": "7c3d1f5e9a0b4c28d6e1f7a3b5c9d2e4f8a6b0c1d3e5f7a9b1c3d5e7f9a1b3c5",
      "examples": [
        {
          "index": 0,
          "operation": "line_total",
          "args": {
            "unit_price": {"type": "integer", "value": "4"},
            "quantity": {"type": "integer", "value": "0"}
          },
          "expect": {"kind": "raises", "type": "", "value": "ValueError"}
        }
      ],
      "tests": [
        {
          "name": "test_zero_quantity_is_rejected",
          "classname": "tests.test_parcel",
